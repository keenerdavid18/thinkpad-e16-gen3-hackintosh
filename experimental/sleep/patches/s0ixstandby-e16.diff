+void S0ixStandby::setupIom()
+{
+	char buf[128] = "not found";
+	const IORegistryPlane *plane = IORegistryEntry::getPlane("IOACPIPlane");
+	OSString *nm = OSString::withCString("PC00");
+	IOACPIPlatformDevice *pc = nullptr;
+	if (plane && nm)
+		if (IORegistryIterator *it = IORegistryIterator::iterateOver(plane, kIORegistryIterateRecursively)) {
+			while (IORegistryEntry *e = it->getNextObject()) {
+				IOACPIPlatformDevice *d = OSDynamicCast(IOACPIPlatformDevice, e);
+				if (d && nm->isEqualTo(d->getName())) { pc = d; break; }
+			}
+			it->release();
+		}
+	OSSafeReleaseNULL(nm);
+	OSObject *r = nullptr;
+	uint64_t base = 0;
+	if (pc && !pc00) { pc->retain(); pc00 = pc; }
+	if (pc && pc->evaluateObject("IOMA", &r) == kIOReturnSuccess && r)
+		if (OSNumber *n = OSDynamicCast(OSNumber, r)) base = n->unsigned64BitValue();
+	OSSafeReleaseNULL(r);
+	if (base) {
+		uint64_t a = base + 0xC10000 + 0x40;
+		if (IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(a & ~0xFFFULL, 0x1000, kIODirectionInOut)) {
+			iomMap = md->map(kIOMapInhibitCache);
+			md->release();
+			if (iomMap) iomReg = reinterpret_cast<volatile uint32_t *>(iomMap->getVirtualAddress() + (a & 0xFFF));
+		}
+		snprintf(buf, sizeof(buf), "IOM+0x40 at 0x%llx = 0x%08x (TD3C b15, TACK b16, DPOF b17)%s", (unsigned long long)a,
+		         iomReg ? *iomReg : 0xFFFFFFFF, iomNoDpof ? "; -s0ixnodpof: DPOF cleared after the entry _DSM" : "");
+	}
+	setProperty("Type-C IOM", buf);
+	LOG("Type-C IOM %s", buf);
+	if (iomReg && !iomCall) iomCall = thread_call_allocate(iomLater, this);
+}
+
+void S0ixStandby::iomLater(thread_call_param_t self, thread_call_param_t)
+{
+	S0ixStandby *me = static_cast<S0ixStandby *>(self);
+	if (!me->iomReg) return;
+	me->iomV[4] = *me->iomReg;
+	char b[160];
+	snprintf(b, sizeof(b), "before entry 0x%08x, after entry 0x%08x, wake before exit 0x%08x, after exit 0x%08x, +2 s 0x%08x",
+	         me->iomV[0], me->iomV[1], me->iomV[2], me->iomV[3], me->iomV[4]);
+	me->setProperty("Type-C IOM at last sleep", b);
+	if (gRc6Valid) {
+		char g[200];
+		snprintf(g, sizeof(g), "RC6 counter %u -> %u (+%u x 1.28 us), TSC +%llu, RC_STATE 0x%08x -> 0x%08x",
+		         gRc6Halt, gRc6Active, gRc6Active - gRc6Halt, (unsigned long long)(gRc6TscActive - gRc6TscHalt),
+		         gRcStateHalt, gRcStateActive);
+		me->setProperty("GT RC6 at last halt", g);
+		gRc6Valid = false; gRc6TscHalt = 0;
+	}
+	if (me->nvN) {
+		char t[300]; size_t n = 0;
+		snAdd(t, sizeof(t), n, "mode 0x%x (%s), %u sleeps:", me->nvMode, (me->nvMode & 0xF) == 2 ? "D0 live PS" : (me->nvMode & 0xF) == 1 ? "D0 shut down" : "macOS D3", me->nvCount);
+		for (uint32_t i = 0; i < me->nvN && n < sizeof(t) - 40; i++)
+			snAdd(t, sizeof(t), n, " %02x:%02x.%x D%u%s", me->nvDev[i]->getBusNumber(), me->nvDev[i]->getDeviceNumber(),
+			              me->nvDev[i]->getFunctionNumber(), me->nvSaved[i] & 3, me->nvChanged[i] ? (me->nvAfter[i] & 3) == 0 ? "->D0" : "->D0 FAILED" : "");
+		me->setProperty("NVMe at last sleep", t);
+
+		char l[600]; size_t m = 0;
+		for (uint32_t i = 0; i < me->nvN && m < sizeof(l) - 120; i++)
+			snAdd(l, sizeof(l), m, "%s%02x:%02x.%x lnkctl %x/%x/%x devctl2 %x/%x/%x l1ss %x/%x/%x ltr %x/%x/%x", m ? "; " : "",
+			              me->nvDev[i]->getBusNumber(), me->nvDev[i]->getDeviceNumber(), me->nvDev[i]->getFunctionNumber(),
+			              me->nvLnk[i][0], me->nvLnk[i][1], me->nvLnk[i][2], me->nvDc2[i][0], me->nvDc2[i][1], me->nvDc2[i][2],
+			              me->nvSs1[i][0], me->nvSs1[i][1], me->nvSs1[i][2], me->nvLtrV[i][0], me->nvLtrV[i][1], me->nvLtrV[i][2]);
+		me->setProperty("NVMe link config (saved/after D0/restored)", l);
+		if ((me->nvMode & 0xF) == 2) {
+			char q[400]; size_t k = 0;
+			for (uint32_t i = 0; i < me->nvN && k < sizeof(q) - 100; i++)
+				if (me->nvPsInfo[i][0]) snAdd(q, sizeof(q), k, "%s%02x:00.0 %s", k ? "; " : "", me->nvDev[i]->getBusNumber(), me->nvPsInfo[i]);
+			me->setProperty("NVMe power state at last sleep", k ? q : "not attempted");
+		}
+	}
+	if (me->nobmMask) {
+		char t[200];
+		snprintf(t, sizeof(t), "mask 0x%x: %u of %u devices had bus mastering cleared at the last sleep, %u sleeps",
+		         me->nobmMask, me->nobmDone, me->nobmN, me->nobmCount);
+		me->setProperty("Bus master off at last sleep", t);
+	}
+	if (me->tcssD3) {
+		char t[260];
+		snprintf(t, sizeof(t), "%u sleeps; xHCI 0d.0 PMCSR at sleep 0x%04x (restored to 0x%04x); TCOF 0x%x%s: IOM 0x%08x -> 0x%08x "
+		         "(TACK after %u ms); wake: IOM 0x%08x, TCON 0x%x -> 0x%08x", me->tcssCount, me->txhcPmcsrSleep,
+		         me->txhcPmcsrSaved, me->tcssRet[0], me->tcssDirect ? " (direct TD3C write)" : "", me->tcssIom[0], me->tcssIom[1], me->tcssAckMs, me->tcssIom[2],
+		         me->tcssRet[1], me->tcssIom[3]);
+		me->setProperty("Type-C D3cold at last sleep", t);
+	}
+	me->publishTypeC();
+}
+
+// TCSS D3cold (-s0ixtcssd3). The DSDT's TCSS xHCI (TXHC) has _PR0/_PR3 = \_SB.PC00.D3C; its _OFF (TCOF) sets the IOM's
+// TD3C bit when no TCSS device asks to skip D3cold, _ON (TCON) clears it and waits for TACK. macOS never does ACPI
+// runtime D3 for these devices, so TD3C stayed 0 in every Deep Idle and the package never left PC2 once the IOM was
+// told the display is off (DPOF or DC9). Only with nothing attached to USB-C (never sleep docked).
+// Called from the 60 s timer (normal thread context, system awake): find the devices and, for -s0ixnvmeps, allocate the
+// admin-queue DMA buffers and map BAR0 now - not in the sleep action.
+// ECAM base from the host bridge's PCIEXBAR (00:00.0 0x60, bit 0 enable, bits 3:1 length: 0 = 256 MB, 1 = 128 MB,
+// 2 = 64 MB, 3 = 512 MB, 4 = 1 GB, 5 = 2 GB, 6 = 4 GB). Each mapping is checked against IOPCIFamily's vendor/device read.
+void S0ixStandby::nvCfgMapAll()
+{
+	nvCfgTried = true;
+	OSDictionary *match = serviceMatching("IOPCIDevice");
+	OSIterator *it = match ? getMatchingServices(match) : nullptr;
+	OSSafeReleaseNULL(match);
+	uint64_t bar = 0;
+	while (it && !bar)
+		if (IOPCIDevice *d = OSDynamicCast(IOPCIDevice, it->getNextObject())) {
+			if (d->getBusNumber() == 0 && d->getDeviceNumber() == 0 && d->getFunctionNumber() == 0)
+				bar = ((uint64_t)d->configRead32(0x64) << 32) | d->configRead32(0x60);
+		} else break;
+	OSSafeReleaseNULL(it);
+	char buf[200];
+	if (!(bar & 1)) { snprintf(buf, sizeof(buf), "PCIEXBAR 0x%llx not enabled", (unsigned long long)bar); setProperty("NVMe config snapshot", buf); return; }
+	static const uint64_t kLen[8] = {256, 128, 64, 512, 1024, 2048, 4096, 256};
+	uint64_t base = bar & ~((kLen[(bar >> 1) & 7] << 20) - 1) & 0x3FFFFFFFFFFULL;
+	size_t k = 0;
+	snAdd(buf, sizeof(buf), k, "ECAM 0x%llx:", (unsigned long long)base);
+	for (uint32_t i = 0; i < nvN && i < kNvCfgSlots; i++) {
+		IOPCIDevice *d = nvDev[i];
+		uint64_t a = base + ((uint64_t)d->getBusNumber() << 20) + ((uint64_t)d->getDeviceNumber() << 15) + ((uint64_t)d->getFunctionNumber() << 12);
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(a, 0x1000, kIODirectionIn);
+		IOMemoryMap *m = md ? md->map(kIOMapInhibitCache | kIOMapReadOnly) : nullptr;
+		OSSafeReleaseNULL(md);
+		volatile uint32_t *p = m ? reinterpret_cast<volatile uint32_t *>(m->getVirtualAddress()) : nullptr;
+		bool ok = p && p[0] == d->configRead32(kIOPCIConfigVendorID) && p[0] != 0xFFFFFFFF;
+		snAdd(buf, sizeof(buf), k, " %02x:%02x.%x %s", d->getBusNumber(), d->getDeviceNumber(), d->getFunctionNumber(), ok ? "ok" : "MISMATCH");
+		if (!ok) { OSSafeReleaseNULL(m); continue; }
+		nvCfgMap[i] = m;
+		uint32_t bdf = ((uint32_t)d->getBusNumber() << 8) | ((uint32_t)d->getDeviceNumber() << 3) | d->getFunctionNumber();
+		if (gCoreSnapLock) IOLockLock(gCoreSnapLock);
+		gNvCfgBdf[i] = bdf; gNvCfg[i] = p;
+		if (gCoreSnapLock) IOLockUnlock(gCoreSnapLock);
+	}
+	setProperty("NVMe config snapshot", buf);
+}
+
+void S0ixStandby::nvmePrep()
+{
+	if (!nvN) {   // root ports 00:06.x first (parents), then the NVMe endpoints (class 01:08:02)
+		OSDictionary *match = serviceMatching("IOPCIDevice");
+		OSIterator *it = match ? getMatchingServices(match) : nullptr;
+		OSSafeReleaseNULL(match);
+		if (!it) return;
+		IOPCIDevice *rp[kNvMax] {}, *ep[kNvMax] {};
+		uint32_t nr = 0, ne = 0;
+		while (OSObject *o = it->getNextObject()) {
+			IOPCIDevice *d = OSDynamicCast(IOPCIDevice, o);
+			if (!d) continue;
+			if (d->getBusNumber() == 0 && d->getDeviceNumber() == 6 && nr < 2) rp[nr++] = d;
+			else if ((d->configRead32(kIOPCIConfigRevisionID) >> 8) == 0x010802 && ne < 2) ep[ne++] = d;
+		}
+		it->release();
+		for (uint32_t i = 0; i < nr; i++) { rp[i]->retain(); nvDev[nvN++] = rp[i]; }
+		for (uint32_t i = 0; i < ne; i++) { ep[i]->retain(); nvDev[nvN++] = ep[i]; }
+		for (uint32_t i = 0; i < nvN; i++) {
+			uint8_t pm = 0, ex = 0; IOByteCount o = 0;
+			nvDev[i]->findPCICapability(kIOPCIPowerManagementCapability, &pm); nvPm[i] = pm;
+			nvDev[i]->findPCICapability(kIOPCIPCIExpressCapability, &ex); nvExp[i] = ex;
+			o = 0; if (nvDev[i]->extendedFindPCICapability(kIOPCIExpressCapabilityIDL1PMSubstates, &o)) nvL1ss[i] = (uint16_t)o;
+			o = 0; if (nvDev[i]->extendedFindPCICapability(kIOPCIExpressCapabilityIDLatencyTolerenceReporting, &o)) nvLtr[i] = (uint16_t)o;
+		}
+	}
+	if (prepAlloc && !nvCfgTried) nvCfgMapAll();
+	if (!prepAlloc) return;
+	for (uint32_t i = 0; i < nvN; i++) {
+		if ((nvDev[i]->configRead32(kIOPCIConfigRevisionID) >> 8) != 0x010802) continue;
+		if (!nvBuf[i]) {
+			nvBuf[i] = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+			                                                           5 * 4096, 0x00000000FFFFF000ULL);
+			if (nvBuf[i] && nvBuf[i]->prepare() != kIOReturnSuccess) OSSafeReleaseNULL(nvBuf[i]);
+		}
+		if (!nvBar[i] && nvDev[i]->configRead16(nvPm[i] + 4) != 0xFFFF && !(nvDev[i]->configRead16(nvPm[i] + 4) & 3))
+			nvBar[i] = nvDev[i]->mapDeviceMemoryWithRegister(kIOPCIConfigBaseAddress0, kIOMapInhibitCache);
+		if ((gNvmeCtl & 0x60) && nvHmbN[i] < kHmbChunks) {
+			for (uint32_t c = nvHmbN[i]; c < kHmbChunks; c++) {
+				IOBufferMemoryDescriptor *b = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+					kIODirectionInOut | kIOMemoryPhysicallyContiguous, kHmbChunkBytes, 0x0000FFFFFFFFF000ULL);
+				if (!b || b->prepare() != kIOReturnSuccess) { OSSafeReleaseNULL(b); break; }
+				nvHmb[i][c] = b; nvHmbN[i] = c + 1;
+			}
+		}
+	}
+}
+
+void S0ixStandby::nvmeSleep()
+{
+	if (!nvN) { prepAlloc = false; nvmePrep(); prepAlloc = true; }   // lookup only: no allocation here
+	nvMode = (uint32_t)gNvmeCtl;
+	for (uint32_t i = 0; i < nvN; i++) {
+		nvChanged[i] = false;
+		nvSaved[i] = nvPm[i] ? nvDev[i]->configRead16(nvPm[i] + 4) : 0;
+		nvAfter[i] = nvSaved[i];
+		IOPCIDevice *d = nvDev[i];
+		auto snap = [&](int k) {
+			if (nvExp[i]) { nvLnk[i][k] = d->configRead16(nvExp[i] + 0x10); nvDc2[i][k] = d->configRead16(nvExp[i] + 0x28); }
+			if (nvL1ss[i]) nvSs1[i][k] = d->configRead32(nvL1ss[i] + 8);
+			if (nvLtr[i]) nvLtrV[i][k] = d->configRead32(nvLtr[i] + 4);
+		};
+		snap(0);
+		if (nvL1ss[i]) nvSs2[i] = d->configRead32(nvL1ss[i] + 0xC);
+		snap(1); snap(2);
+		const bool isEp = (d->configRead32(kIOPCIConfigRevisionID) >> 8) == 0x010802;
+		const uint32_t sel = nvMode & 0x300, bus = d->getBusNumber();
+		const bool picked = !isEp || !sel || (bus == 4 && (sel & 0x100)) || (bus == 5 && (sel & 0x200));
+		const bool keepD3 = isEp && ((bus == 4 && (nvMode & 0x400)) || (bus == 5 && (nvMode & 0x800)));
+		if ((nvMode & 0xF) >= 1 && !keepD3 && nvPm[i] && (nvSaved[i] & 3) && nvSaved[i] != 0xFFFF) {   // D0: every drive but keepD3
+			d->configWrite16(nvPm[i] + 4, (uint16_t)(nvSaved[i] & ~3));
+			IODelay(10000);                                   // D3hot -> D0: 10 ms
+			nvAfter[i] = d->configRead16(nvPm[i] + 4);
+			nvChanged[i] = true;
+			snap(1);
+			// restore what the D3hot -> D0 reset lost: LTR enable + values, L1SS (CTL2, CTL1), ASPM last (PCIe spec order)
+			if (nvExp[i] && nvDc2[i][1] != nvDc2[i][0]) d->configWrite16(nvExp[i] + 0x28, nvDc2[i][0]);
+			if (nvLtr[i] && nvLtrV[i][1] != nvLtrV[i][0]) d->configWrite32(nvLtr[i] + 4, nvLtrV[i][0]);
+			if (nvL1ss[i] && nvSs1[i][1] != nvSs1[i][0]) {
+				if (nvExp[i]) d->configWrite16(nvExp[i] + 0x10, (uint16_t)(d->configRead16(nvExp[i] + 0x10) & ~3));
+				d->configWrite32(nvL1ss[i] + 0xC, nvSs2[i]);
+				d->configWrite32(nvL1ss[i] + 8, nvSs1[i][0]);
+			}
+			if (nvExp[i] && (d->configRead16(nvExp[i] + 0x10) & 0x3) != (nvLnk[i][0] & 0x3))
+				d->configWrite16(nvExp[i] + 0x10, (uint16_t)((d->configRead16(nvExp[i] + 0x10) & ~0x3) | (nvLnk[i][0] & 0x3)));
+			snap(2);
+		}
+		nvCtrlUp[i] = false; nvPsInfo[i][0] = 0;
+		if ((nvMode & 0xF) == 2 && nvChanged[i] && isEp && picked) {                           // live PS: picked drives
+			nvCtrlUp[i] = nvmeCtrlPs(i);
+			if (nvCtrlUp[i] && (nvMode & 0x10)) {                   // MSI-X function mask for the halt
+				uint8_t mx = 0;
+				if (d->findPCICapability(kIOPCIMSIXCapability, &mx) && mx) {
+					nvMsixSaved[i] = d->configRead16(mx + 2); nvMsix[i] = mx;
+					d->configWrite16(mx + 2, (uint16_t)(nvMsixSaved[i] | 0x4000));
+				}
+			}
+		}
+	}
+}
+
+// Minimal NVMe admin path for the halt only (no I/O commands). Registers: CAP 0x0, CC 0x14, CSTS 0x1C, AQA 0x24,
+// ASQ 0x28, ACQ 0x30, doorbells 0x1000 (SQ0 tail) / 0x1000 + (4 << DSTRD) (CQ0 head).
+bool S0ixStandby::nvmeCtrlPs(uint32_t i)
+{
+	IOPCIDevice *d = nvDev[i];
+	auto info = [&](const char *msg) { snprintf(nvPsInfo[i], sizeof(nvPsInfo[i]), "%s", msg); };
+	if (!nvBuf[i] || !nvBar[i]) { info(!nvBuf[i] ? "no DMA buffer (not prepared)" : "BAR0 not mapped (not prepared)"); return false; }
+	nvCmdSaved[i] = d->configRead16(kIOPCIConfigCommand);
+	d->configWrite16(kIOPCIConfigCommand, (uint16_t)(nvCmdSaved[i] | kIOPCICommandMemorySpace | kIOPCICommandBusMaster));
+	volatile uint8_t *r = reinterpret_cast<volatile uint8_t *>(nvBar[i]->getVirtualAddress());
+	auto r32 = [&](uint32_t o) { return *reinterpret_cast<volatile uint32_t *>(r + o); };
+	auto w32 = [&](uint32_t o, uint32_t v) { *reinterpret_cast<volatile uint32_t *>(r + o) = v; };
+	auto w64 = [&](uint32_t o, uint64_t v) { w32(o, (uint32_t)v); w32(o + 4, (uint32_t)(v >> 32)); };
+	const uint64_t cap = (uint64_t)r32(0) | ((uint64_t)r32(4) << 32);
+	if (cap == ~0ULL || r32(0x1C) == 0xFFFFFFFF) { info("controller not responding"); d->configWrite16(kIOPCIConfigCommand, nvCmdSaved[i]); return false; }
+	const uint32_t toMs = (uint32_t)((cap >> 24) & 0xFF) * 500, dstrd = (uint32_t)((cap >> 32) & 0xF);
+	auto waitRdy = [&](uint32_t want) {
+		for (uint32_t t = 0; t < toMs + 500; t++) { const uint32_t st = r32(0x1C); if (st == 0xFFFFFFFF) return false; if ((st & 1) == want) return true; IODelay(1000); }
+		return false;
+	};
+	// reset (the driver left it shut down), then enable with our admin queues
+	w32(0x14, r32(0x14) & ~1u);
+	if (!waitRdy(0)) { info("reset timeout"); return false; }
+	uint8_t *mem = reinterpret_cast<uint8_t *>(nvBuf[i]->getBytesNoCopy());
+	bzero(mem, 5 * 4096);
+	const uint64_t pa = nvBuf[i]->getPhysicalSegment(0, nullptr, kIOMemoryMapperNone);
+	w32(0x24, (7u << 16) | 7u);                               // 8-entry admin SQ / CQ (no wrap: 5 commands)
+	w64(0x28, pa); w64(0x30, pa + 4096);
+	w32(0x14, (4u << 20) | (6u << 16) | 1u);                  // IOCQES 16 B, IOSQES 64 B, MPS 4 KB, NVM, EN
+	if (!waitRdy(1)) { info("enable timeout"); w32(0x14, 0); waitRdy(0); return false; }
+	uint32_t tail = 0;
+	auto admin = [&](uint8_t opc, uint16_t cid, uint64_t prp1, uint32_t c10, uint32_t c11, uint32_t &status) {
+		volatile uint32_t *sq = reinterpret_cast<volatile uint32_t *>(mem + tail * 64);
+		for (int k = 0; k < 16; k++) sq[k] = 0;
+		sq[0] = opc | ((uint32_t)cid << 16);
+		sq[6] = (uint32_t)prp1; sq[7] = (uint32_t)(prp1 >> 32);
+		sq[10] = c10; sq[11] = c11;
+		const uint32_t slot = tail;
+		tail = (tail + 1) & 7;
+		OSSynchronizeIO();
+		w32(0x1000, tail);
+		volatile uint32_t *cq = reinterpret_cast<volatile uint32_t *>(mem + 4096 + slot * 16);
+		for (int t = 0; t < 2000; t++) {
+			if (cq[3] & 0x10000) { status = (cq[3] >> 17) & 0x7FFF; w32(0x1000 + (4u << dstrd), tail); return true; }
+			IODelay(500);
+		}
+		return false;
+	};
+	uint32_t st = 0;
+	if (!admin(0x06, 1, pa + 8192, 1, 0, st) || st) {          // Identify Controller
+		snprintf(nvPsInfo[i], sizeof(nvPsInfo[i]), "identify failed (status 0x%x)", st); w32(0x14, 0); waitRdy(0); return false;
+	}
+	const uint8_t *id = mem + 8192;
+	const uint32_t npss = id[263];
+	int ps = -1;
+	for (int k = (int)npss; k >= 0; k--) if (id[2048 + 32 * k + 3] & 2) { ps = k; break; }   // deepest non-operational
+	if (ps < 0) ps = (int)npss;
+	// like a normally initialised (Linux) controller: one I/O queue pair (Number of Queues, Create I/O CQ, Create I/O SQ)
+	bool ioq = admin(0x09, 3, 0, 0x07, 0, st) && !st;                                     // Set Features: 1 SQ + 1 CQ
+	const uint32_t stNq = st;
+	if (ioq) ioq = admin(0x05, 4, pa + 4 * 4096, (3u << 16) | 1u, 1u, st) && !st;        // Create I/O CQ 1, 4 entries, PC, no IRQ
+	const uint32_t stCq = st;
+	if (ioq) ioq = admin(0x01, 5, pa + 3 * 4096, (3u << 16) | 1u, (1u << 16) | 1u, st) && !st;   // Create I/O SQ 1 -> CQ 1, PC
+	// Host Memory Buffer (Identify: HMPRE @272, HMMIN @276 in 4 KB units, HMMINDS @332, HMMAXD @336)
+	const uint32_t hmpre = *reinterpret_cast<const uint32_t *>(id + 272), hmmin = *reinterpret_cast<const uint32_t *>(id + 276);
+	const uint16_t hmmaxd = *reinterpret_cast<const uint16_t *>(id + 336);
+	char hmb[48] = "no HMB";
+	uint32_t hmbSt = 0;
+	if ((nvMode & 0x60) && hmmin) {
+		const uint32_t pages = kHmbChunkBytes / 4096, need = (hmmin + pages - 1) / pages;
+		if (nvHmbN[i] < need || (hmmaxd && hmmaxd < need)) {
+			snprintf(hmb, sizeof(hmb), "HMB skipped (%u of %u chunks, maxd %u)", nvHmbN[i], need, hmmaxd);
+		} else {
+			uint32_t *dl = reinterpret_cast<uint32_t *>(mem + 8192);     // descriptor list (identify page, already parsed)
+			bzero(dl, 4096);
+			for (uint32_t c = 0; c < need; c++) {
+				const uint64_t a = nvHmb[i][c]->getPhysicalSegment(0, nullptr, kIOMemoryMapperNone);
+				dl[c * 4] = (uint32_t)a; dl[c * 4 + 1] = (uint32_t)(a >> 32); dl[c * 4 + 2] = pages;
+			}
+			auto sf = [&](uint16_t cid, uint32_t c11, uint32_t c12, uint64_t list, uint32_t cnt, uint32_t &stat) {
+				volatile uint32_t *sq = reinterpret_cast<volatile uint32_t *>(mem + tail * 64);
+				for (int k = 0; k < 16; k++) sq[k] = 0;
+				sq[0] = 0x09 | ((uint32_t)cid << 16);
+				sq[10] = 0x0D; sq[11] = c11; sq[12] = c12; sq[13] = (uint32_t)list; sq[14] = (uint32_t)(list >> 32); sq[15] = cnt;
+				const uint32_t slot = tail; tail = (tail + 1) & 7;
+				OSSynchronizeIO(); w32(0x1000, tail);
+				volatile uint32_t *cq = reinterpret_cast<volatile uint32_t *>(mem + 4096 + slot * 16);
+				for (int t = 0; t < 4000; t++) {
+					if (cq[3] & 0x10000) { stat = (cq[3] >> 17) & 0x7FFF; w32(0x1000 + (4u << dstrd), tail); return true; }
+					IODelay(500);
+				}
+				return false;
+			};
+			const bool on = sf(6, 1, need * pages, pa + 8192, need, hmbSt) && !hmbSt;
+			if (on) IODelay(200000);                                            // let the drive load its tables
+			bool off = true;
+			if (on && !(nvMode & 0x40)) off = sf(7, 0, 0, 0, 0, hmbSt) && !hmbSt;   // Linux: disable before PS
+			snprintf(hmb, sizeof(hmb), "HMB %u MB %s%s (0x%x)", need * pages / 256, on ? "on" : "FAILED",
+			         on ? ((nvMode & 0x40) ? ", kept" : off ? ", off" : ", off FAILED") : "", hmbSt);
+		}
+	}
+	(void)hmpre;
+	uint8_t msix = 0; d->findPCICapability(kIOPCIMSIXCapability, &msix);
+	const bool msixOn = msix && (d->configRead16(msix + 2) & 0x8000);
+	if (!admin(0x09, 2, 0, 0x02, (uint32_t)ps, st) || st) {    // Set Features: Power Management
+		snprintf(nvPsInfo[i], sizeof(nvPsInfo[i]), "set PS%d failed (status 0x%x, npss %u)", ps, st, npss); w32(0x14, 0); waitRdy(0); return false;
+	}
+	snprintf(nvPsInfo[i], sizeof(nvPsInfo[i]), "PS%d of 0-%u, I/O queues %s, MSI-X %s, %s", ps, npss,
+	         ioq ? "ok" : "FAILED", msix ? (msixOn ? "on" : "off") : "none", hmb);
+	return true;
+}
+
+void S0ixStandby::nvmeCtrlReset(uint32_t i)
+{
+	if (nvBar[i]) {
+		volatile uint32_t *cc = reinterpret_cast<volatile uint32_t *>(nvBar[i]->getVirtualAddress() + 0x14);
+		volatile uint32_t *csts = reinterpret_cast<volatile uint32_t *>(nvBar[i]->getVirtualAddress() + 0x1C);
+		*cc = *cc & ~1u;
+		for (int t = 0; t < 2000 && *csts != 0xFFFFFFFF && (*csts & 1); t++) IODelay(1000);
+	}
+	nvDev[i]->configWrite16(kIOPCIConfigCommand, nvCmdSaved[i]);
+}
+
+void S0ixStandby::nvmeWake()
+{
+	if (!nvN) return;
+	for (int i = (int)nvN - 1; i >= 0; i--)                   // endpoints first, then the root ports
+		if (nvChanged[i]) {
+			if (nvMsix[i]) { nvDev[i]->configWrite16(nvMsix[i] + 2, nvMsixSaved[i]); nvMsix[i] = 0; }
+			if (nvCtrlUp[i]) { nvmeCtrlReset(i); nvCtrlUp[i] = false; }
+			uint16_t v = nvDev[i]->configRead16(nvPm[i] + 4);
+			if (v != 0xFFFF) nvDev[i]->configWrite16(nvPm[i] + 4, (uint16_t)((v & ~3) | (nvSaved[i] & 3)));
+			IODelay(1000);
+		}
+	nvCount++;
+}
+
+void S0ixStandby::nobmSleep()
+{
+	static const struct { uint32_t bit; uint8_t dev, fn; } kList[] = {
+		{1, 0x14, 3}, {2, 0x1f, 6}, {4, 0x1f, 3}, {8, 0x14, 0}, {0x10, 0x15, 0}, {0x10, 0x15, 2}, {0x20, 0x0d, 0}, {0x40, 0x07, 0},
+	};
+	nobmDone = 0;
+	if (!nobmN) {   // resolve once
+		OSDictionary *match = serviceMatching("IOPCIDevice");
+		OSIterator *it = match ? getMatchingServices(match) : nullptr;
+		OSSafeReleaseNULL(match);
+		if (!it) return;
+		while (OSObject *o = it->getNextObject()) {
+			IOPCIDevice *d = OSDynamicCast(IOPCIDevice, o);
+			if (!d || d->getBusNumber() != 0) continue;
+			for (auto &w : kList)
+				if ((nobmMask & w.bit) && d->getDeviceNumber() == w.dev && d->getFunctionNumber() == w.fn && nobmN < kNoBmMax) {
+					d->retain(); nobmDev[nobmN++] = d;
+				}
+		}
+		it->release();
+	}
+	for (uint32_t i = 0; i < nobmN; i++) {
+		nobmCmd[i] = nobmDev[i]->configRead16(kIOPCIConfigCommand);
+		if (nobmCmd[i] != 0xFFFF && (nobmCmd[i] & kIOPCICommandBusMaster)) {
+			nobmDev[i]->configWrite16(kIOPCIConfigCommand, (uint16_t)(nobmCmd[i] & ~kIOPCICommandBusMaster));
+			nobmDone++;
+		} else {
+			nobmCmd[i] = 0;   // nothing to restore
+		}
+	}
+}
+
+void S0ixStandby::nobmWake()
+{
+	if (!nobmMask) return;
+	for (uint32_t i = 0; i < nobmN; i++)
+		if (nobmCmd[i]) {
+			uint16_t v = nobmDev[i]->configRead16(kIOPCIConfigCommand);
+			if (v != 0xFFFF) nobmDev[i]->configWrite16(kIOPCIConfigCommand, (uint16_t)(v | kIOPCICommandBusMaster));
+			nobmCmd[i] = 0;
+		}
+	nobmCount++;
+}
+
+void S0ixStandby::tcssSleep()
+{
+	tcssOff = false;
+	if (!pc00 || !txhcDev || !txhcPm || !iomReg) return;
+	txhcPmcsrSleep = txhcDev->configRead16(txhcPm + 4);
+	txhcPmcsrSaved = txhcPmcsrSleep;
+	if ((txhcPmcsrSleep & 3) != 3) {
+		txhcDev->configWrite16(txhcPm + 4, (uint16_t)((txhcPmcsrSleep & ~3) | 3));
+		IODelay(10000);                                   // D0 -> D3hot: 10 ms
+	}
+	tcssIom[0] = *iomReg;
+	// D3C._OFF only calls \_SB.PC00.TCOF; Apple's evaluateObject takes a plain device-relative name (a dotted path
+	// returned kIOReturnBadArgument). Fallback when TCOF is not defined (If (TRTD)): set TD3C (bit 15) directly.
+	tcssRet[0] = pc00->evaluateObject("TCOF");
+	tcssDirect = tcssRet[0] != kIOReturnSuccess;
+	if (tcssDirect) *iomReg = *iomReg | (1u << 15);
+	tcssAckMs = 0;
+	while (tcssAckMs < 100 && !(*iomReg & (1u << 16))) { IODelay(1000); tcssAckMs++; }
+	tcssIom[1] = *iomReg;
+	tcssOff = (*iomReg & (1u << 15)) != 0;
+	if (!tcssOff && (txhcPmcsrSaved & 3) != 3) txhcDev->configWrite16(txhcPm + 4, txhcPmcsrSaved);
+}
+
+void S0ixStandby::tcssWake()
+{
+	if (!tcssOff) return;
+	tcssOff = false;
+	tcssIom[2] = iomReg ? *iomReg : 0;
+	tcssRet[1] = tcssDirect ? kIOReturnUnsupported : pc00->evaluateObject("TCON");
+	if (iomReg && (*iomReg & (1u << 15))) {                     // TCON missing or failed: clear TD3C, wait TACK low
+		*iomReg = *iomReg & ~(1u << 15);
+		for (int i = 0; i < 100 && (*iomReg & (1u << 16)); i++) IODelay(1000);
+	}
+	tcssIom[3] = iomReg ? *iomReg : 0;
+	if ((txhcPmcsrSaved & 3) != 3) {
+		uint16_t v = txhcDev->configRead16(txhcPm + 4);
+		txhcDev->configWrite16(txhcPm + 4, (uint16_t)((v & ~3) | (txhcPmcsrSaved & 3)));
+		IODelay(10000);
+	}
+	tcssCount++;
+}
+
+void S0ixStandby::setupLidWake()
+{
+	setProperty("Keyboard wake", kbWake ? "armed during Deep Idle when the lid is open (-s0ixkbdwake): i8042 keyboard port + IRQ1"
+	                                    : "off (boot-arg -s0ixkbdwake)");
+	if ((kbWake || edWake) && !ioapic) {
+		// MADT on this machine: one I/O APIC at 0xFEC00000, no source override for IRQ1 (GSI 1).
+		if (IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(0xFEC00000ULL, 0x1000, kIODirectionInOut)) {
+			ioapicMap = md->map(kIOMapInhibitCache);
+			md->release();
+			if (ioapicMap) {
+				ioapic = reinterpret_cast<volatile uint32_t *>(ioapicMap->getVirtualAddress());
+				ioapic[0] = 0x01;                               // IOAPICVER: sanity check
+				uint32_t ver = ioapic[4];
+				if ((ver & 0xFF) < 0x11 || ((ver >> 16) & 0xFF) < 1) { ioapic = nullptr; OSSafeReleaseNULL(ioapicMap); }
+			}
+		}
+	}
+	if (!lwWake && !kbWake) { setProperty("Lid wake", "off (boot-arg -s0ixlidwake)"); return; }
+	static const char *hids[2] = { "PNP0C0D", "PNP0C0E" };
+	const IORegistryPlane *plane = IORegistryEntry::getPlane("IOACPIPlane");
+	if (!plane) return;
+	for (int i = 0; i < 2; i++) {
+		OSString *hid = OSString::withCString(hids[i]);
+		if (!hid) continue;
+		if (IORegistryIterator *it = IORegistryIterator::iterateOver(plane, kIORegistryIterateRecursively)) {
+			while (IORegistryEntry *e = it->getNextObject()) {
+				IOACPIPlatformDevice *d = OSDynamicCast(IOACPIPlatformDevice, e);
+				if (!d || !d->compareName(hid, nullptr)) continue;
+				d->retain();
+				lwDev[i] = d;
+				OSObject *prw = nullptr;
+				if (lwGpe == 0xFFFFFFFF && d->evaluateObject("_PRW", &prw) == kIOReturnSuccess && prw) {
+					if (OSArray *a = OSDynamicCast(OSArray, prw))
+						if (OSNumber *n = OSDynamicCast(OSNumber, a->getObject(0)))
+							lwGpe = n->unsigned32BitValue();
+				}
+				OSSafeReleaseNULL(prw);
+				break;
+			}
+			it->release();
+		}
+		hid->release();
+	}
+	if (lwGpe != 0xFFFFFFFF && (!gpe0EnPort || lwGpe / 8 >= gpe0Half)) lwGpe = 0xFFFFFFFF;
+	// GPIO-routed GPE (DW0..DW2 = GPEs 0x00-0x5F): find its group/pad from the BIOS GNVS (GEI0-2 group, GED0-2 dword)
