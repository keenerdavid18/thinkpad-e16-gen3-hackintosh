+void S0ixStandby::lidPsw(bool on)
+{
+	for (int i = 0; i < 2; i++) {
+		if (!lwDev[i]) continue;
+		OSObject *arg = OSNumber::withNumber(on ? 1 : 0, 32);
+		if (!arg) continue;
+		IOReturn r = lwDev[i]->evaluateObject("_PSW", nullptr, &arg, 1);
+		DBG("%s._PSW(%d) -> 0x%x", lwDev[i]->getName(), on ? 1 : 0, r);
+		arg->release();
+	}
+}
