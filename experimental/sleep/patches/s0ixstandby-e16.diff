+void S0ixStandby::setupHpetFix()
+{
+	// Opt-in while it is confirmed on more platforms (verified on ADL-P,
+	// brandonedley, #11). Without the boot-arg the HPET is only read, so
+	// s0ix-status.sh shows whether the standing match is there.
+	hpetFixEnabled = bootArg("-s0ixhpetfix") && !bootArg("-s0ixnohpetfix");
+	uint64_t addr = 0;
+	const OSData *tbl = nullptr;
+	if (IOACPIPlatformExpert *acpi = OSDynamicCast(IOACPIPlatformExpert, getPlatform()))
+		tbl = ACPITableAccess::get(acpi, "HPET", 0);
+	if (!tbl && getPlatform())
+		if (OSDictionary *tables = OSDynamicCast(OSDictionary, getPlatform()->getProperty("ACPI Tables")))
+			tbl = OSDynamicCast(OSData, tables->getObject("HPET"));
+	if (tbl && tbl->getLength() >= 52) {
+		const uint8_t *p = static_cast<const uint8_t *>(tbl->getBytesNoCopy());
+		if (p[40] == 0) addr = OSReadLittleInt64(p, 44); // ACPI GAS: SystemMemory
+	}
+	if (!addr) addr = 0xFED00000ULL;
+	if (IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(addr, 0x1000, kIODirectionInOut)) {
+		hpetMap = md->map(kIOMapInhibitCache);
+		md->release();
+		if (hpetMap) {
+			hpetReg = reinterpret_cast<volatile uint32_t *>(hpetMap->getVirtualAddress());
+			uint32_t cap0 = hpetReg[0], cap1 = hpetReg[1];
+			if (cap0 == 0xFFFFFFFFu || cap1 == 0xFFFFFFFFu || (cap0 & 0xFFu) == 0) {
+				hpetReg = nullptr;
+				OSSafeReleaseNULL(hpetMap);
+			}
+		}
+	}
+	if (!hpetReg) {
+		setProperty("HPET comparator fix", "unavailable (no valid HPET MMIO)");
+		return;
+	}
+	hpetAddr = addr;
+	uint32_t mask = 0;
+	hpetClearMatches(&mask, hpetFixEnabled);
+	publishHpet(mask);
+	LOG("HPET at 0x%llx: CONF 0x%x, CNT 0x%x, standing match mask 0x%x, fix %s",
+	    (unsigned long long)hpetAddr, hpetReg[0x10 / 4], hpetReg[0xF0 / 4], mask, hpetFixEnabled ? "on" : "off");
+}
+
+// "HPET comparator fix": the HPET state now and what the fix has done.
+// mask = disabled timers whose comparator equals the stopped main counter.
+void S0ixStandby::publishHpet(uint32_t mask)
+{
+	if (!hpetReg) return;
+	uint32_t conf = hpetReg[0x10 / 4], cnt = hpetReg[0xF0 / 4];
+	char buf[240];
+	if (hpetFixEnabled)
+		snprintf(buf, sizeof(buf), "on (-s0ixhpetfix): HPET 0x%llx CONF 0x%x CNT 0x%x; cleared %u comparator(s) so far (timers 0x%x)",
+		         (unsigned long long)hpetAddr, conf, cnt, hpetFixCount, hpetFixMask);
+	else if (conf & 1u)
+		snprintf(buf, sizeof(buf), "off: HPET 0x%llx running (CONF 0x%x), no standing match", (unsigned long long)hpetAddr, conf);
+	else if (mask)
+		snprintf(buf, sizeof(buf), "off: HPET 0x%llx stopped (CONF 0x%x, CNT 0x%x) with comparator == counter on timers 0x%x; "
+		         "this can keep SLP_S0 at 0 (see -s0ixhpetfix)", (unsigned long long)hpetAddr, conf, cnt, mask);
+	else
+		snprintf(buf, sizeof(buf), "off: HPET 0x%llx stopped (CONF 0x%x, CNT 0x%x), no standing match", (unsigned long long)hpetAddr, conf, cnt);
+	setProperty("HPET comparator fix", buf);
+}
