+// XE-EDPWAKE teardown (from wrapEnableDC9, i.e. Apple's clientNotify once every client sleeps, before DC_STATE_EN=DC9):
+// Apple's overridePowerWellsState(false) leaves DBUF and the CTL1 well requests on here (measured at the halt: DBUF_CTL_S1
+// 0xc0000000, CTL1 0x40f, Display_VNN_REQ set, package PC2 99 %). Linux icl_display_core_uninit order, after the eDP
+// output is shut down (plane, transcoder, link, panel power, DPLL1). The wake replay rebuilds all of it.
+static uint32_t gEwPpCtl;   // PP_CONTROL before the panel was powered off (0 = panel left alone)
+static void xeEdpSleepTeardown()
+{
+	if (!NGreen::callback || !gEwValid) return;
+	gEwLogN = 0;
+	ewLog("teardown: wells %x/%x aux %x ddi %x dbuf %x/%x cdpll %x cdclk %x dpll %x buf %x conf %x pp %x/%x", ewRd(0x45400),
