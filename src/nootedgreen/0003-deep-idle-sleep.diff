+static void xeEdpWakeReplay()
+{
+	if (!xeEdpWakeOn() || !gEwValid || !NGreen::callback) return;
+	if (ewRd(0x70008) & 0x80000000u) return;   // transcoder A still running: nothing lost
+	gEwLogN = 0;
+	const uint32_t *S = gEwSaved;
+	if (gEwPpCtl && !(ewRd(0xC7200) & 0x80000000u)) {                    // panel powered off by the teardown
+		ewWr(0xC7204, gEwPpCtl);
+		int t = 0;
+		for (; t < 80 && (ewRd(0xC7200) & 0xB0000000u) != 0x80000000u; t++) IOSleep(10);   // on, no sequence in progress
+		ewLog("panel power on: pp %x/%x after %d ms", ewRd(0xC7200), ewRd(0xC7204), t * 10);
+	}
+	ewLog("replay: wells %x/%x dc %x cdclk %x dpll %x buf %x conf %x func %x", ewRd(0x45400), ewRd(0x45404), ewRd(0x45504),
+	      ewRd(0x46000), ewRd(0x46014), ewRd(0x64000), ewRd(0x70008), ewRd(0x60400));
+	// 1. DPLL1: power, config, enable + lock
+	if (!(ewRd(0x46014) & (1u << 30))) {
+		ewWr(0x46014, ewRd(0x46014) | (1u << 27));
+		const bool pw = ewWait(0x46014, 1u << 26, 1u << 26, 5000);
+		ewWr(0x16428C, S[kEwCfg0]); ewWr(0x164290, S[kEwCfg1]); (void)ewRd(0x164290);
+		ewWr(0x46014, ewRd(0x46014) | (1u << 31));
+		const bool lk = ewWait(0x46014, 1u << 30, 1u << 30, 5000);
+		ewLog("dpll1 power %d lock %d -> %x (cfgcr %x/%x)", pw, lk, ewRd(0x46014), ewRd(0x16428C), ewRd(0x164290));
+		if (!lk) { ewPublish("ngreen-edpwake"); return; }
+	}
+	// 2. DDI A clock (DPLL1, clock on) and the transcoder clock
+	ewWr(0x164280, S[kEwDpclka]);
+	ewWr(0x46140, S[kEwClkSel]);
+	// 3. transcoder A timings / M/N / pipe source, transcoder function configured but not yet enabled
+	for (uint32_t i = kEwHtot; i <= kEwLn1; i++) ewWr(kEdpWakeRegs[i], S[i]);
+	ewWr(0x70030, S[kEwMisc]);
+	ewWr(0x60404, S[kEwDdiFunc2]);
+	ewWr(0x60400, S[kEwDdiFunc] & ~0x80000000u);
+	ewWr(0x60410, gEwMsa);                                                  // MSA: bpc / colour format
+	// 4. combo PHY A lane levels: only if DC9 lost them (restore UEFI's raw values, Linux icl_combo_phy_set_signal_levels order)
+	bool lost = false;
+	for (uint32_t i = 0; i < 4; i++)
+		lost |= ewRd(kEdpWakeRegs[kEwDw2 + i]) != S[kEwDw2 + i] || ewRd(kEdpWakeRegs[kEwDw4 + i]) != S[kEwDw4 + i] ||
+		        ewRd(kEdpWakeRegs[kEwDw7 + i]) != S[kEwDw7 + i];
+	lost |= ewRd(0x162894) != S[kEwDw5] || ewRd(0x162028) != S[kEwCl10];
+	if (lost) {
+		ewWr(0x162694, ewRd(0x162894) & ~0x80000000u);                       // TX_DW5 grp: training off
+		for (uint32_t i = 0; i < 4; i++) {
+			ewWr(kEdpWakeRegs[kEwDw2 + i], S[kEwDw2 + i]);
+			ewWr(kEdpWakeRegs[kEwDw4 + i], S[kEwDw4 + i]);
+			ewWr(kEdpWakeRegs[kEwDw7 + i], S[kEwDw7 + i]);
+		}
+		ewWr(0x162028, S[kEwCl10]);
+		ewWr(0x162694, S[kEwDw5]);                                          // TX_DW5 grp: saved (training enabled)
+	}
+	ewLog("phy levels %s: dw2 %x dw4 %x dw7 %x dw5 %x cl10 %x", lost ? "RESTORED" : "kept", ewRd(0x162888), ewRd(0x162890),
+	      ewRd(0x16289C), ewRd(0x162894), ewRd(0x162028));
+	// 5. sink: D0, link rate / lanes / downspread / coding
+	const uint32_t lanes = gEwCfg[1] & 0x1F;
+	bool ok = ewDpcdW(0x600, 0x01);
+	IOSleep(1);
+	if (gEwCfg[0]) ok &= ewDpcdW(0x100, gEwCfg[0]); else ok &= ewDpcdW(0x115, gEwRate);
+	ok &= ewDpcdW(0x101, gEwCfg[1]);
+	ok &= ewDpcdW(0x107, gEwCfg[7]);
+	ok &= ewDpcdW(0x108, gEwCfg[8] ? gEwCfg[8] : 1);
+	ewLog("sink config %s: bw %02x rate_sel %02x lanes %u", ok ? "ok" : "FAIL", gEwCfg[0], gEwRate, lanes);
+	// 6. source: DP_TP_CTL enabled with TPS1, DDI buffer on
+	const uint32_t tpBase = (1u << 31) | (S[kEwTp] & (1u << 18));          // enable + enhanced framing as before
+	ewWr(0x60540, tpBase);
+	ewWr(0x64000, S[kEwBuf] | 0x80000000u);
+	IODelay(600);
+	const bool active = ewWait(0x64000, 1u << 7, 0, 2000);
+	ewLog("ddi buf %x active %d", ewRd(0x64000), active);
+	const bool trained = ok && lanes >= 1 && lanes <= 4 && ewTrain(lanes, tpBase);
+	// 7. normal pixels, transcoder function + transcoder on (also after a failed training, to see what the panel shows)
+	ewWr(0x60540, tpBase | (2u << 8));                                      // idle pattern
+	IODelay(100);
+	ewWr(0x60540, tpBase | (3u << 8));                                      // normal
+	ewDpcdW(0x102, 0x00);
+	ewWr(0x60400, S[kEwDdiFunc] | 0x80000000u);
+	if (S[kEwPsCtl] & 0x80000000u) { ewWr(0x68170, S[kEwPsPos]); ewWr(0x68174, S[kEwPsSz]); ewWr(0x68180, S[kEwPsCtl]); }
+	ewWr(0x70008, S[kEwConf] & ~(1u << 30));
+	const bool running = ewWait(0x70008, 1u << 30, 1u << 30, 50000);
+	IOSleep(40);
+	ewLog("done trained %d running %d: conf %x func %x tp %x tpst %x frm %x", trained, running, ewRd(0x70008), ewRd(0x60400),
+	      ewRd(0x60540), ewRd(0x60544), ewRd(0x70040));
+	// what else differs from the pre-sleep state (frame/flip counters, timestamps and plane surface addresses excluded)
+	{
+		uint32_t n = 0, diffs = 0; char line[150]; size_t ln = 0;
+		for (auto &r : kEwRanges)
+			for (uint32_t o = r.from; o < r.to; o += 4, n++) {
+				if ((o >= 0x70040 && o <= 0x7004C) || o == 0x7019C || o == 0x701AC) continue;
+				const uint32_t now = ewRd(o);
+				if (now == gEwBroad[n]) continue;
+				diffs++;
+				if (ln < sizeof(line) - 30) ln += snprintf(line + ln, sizeof(line) - ln, " %x:%x>%x", o, gEwBroad[n], now);
+				else { ewLog("diff%s", line); ln = 0; ln += snprintf(line + ln, sizeof(line) - ln, " %x:%x>%x", o, gEwBroad[n], now); }
+			}
+		if (ln) ewLog("diff%s", line);
+		ewLog("msa %x (saved %x), %u registers differ from sleep", ewRd(0x60410), gEwMsa, diffs);
+	}
+	ewPublish("ngreen-edpwake");
+}
 static uint32_t gXeFbBlcCtl = 0, gXeFbBlcDuty = 0;
