+// -ngreennodc9: Apple's clientNotify() requests DC9 when every client sleeps; in Deep Idle that powers the display
+// core off and neither Apple's TGL framebuffer nor XE-FBDPMS re-initialises it (black panel after wake).
+static bool xeEdpWakeOn();
+static void xeEdpSleepTeardown();
+uint64_t Gen11::wrapEnableDC9(void *that)
+{
+	static int skip = -1;
+	if (skip < 0) skip = checkKernelArgument("-ngreennodc9") ? 1 : 0;
+	if (skip) {
+		static uint32_t n = 0;
+		if (n++ < 4) IOLog("XeNG NODC9: enableDC9 skipped (%u)\n", n);
+		return 0;
+	}
+	if (xeEdpWakeOn()) xeEdpSleepTeardown();   // XE-EDPWAKE: uninit the display core so DC9 can really power it off
+	return FunctionCast(wrapEnableDC9, callback->oEnableDC9)(that);
+}
+
+// The display-mode NVRAM save is for Apple's boot firmware only; skip it (see the route comment).
+uint32_t Gen11::wrapHwSaveNVRAM(void *that)
+{
+	static uint32_t calls = 0;
+	if (calls++ < 4) SYSLOG("ngreen", "hwSaveNVRAM skipped (call %u)", calls);
+	return 0;
+}
