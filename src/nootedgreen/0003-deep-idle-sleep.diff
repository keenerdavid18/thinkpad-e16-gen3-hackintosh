+// Broad snapshot for the post-replay diff (what else DC9 lost): transcoder A, DDI A function/MSA, DP_TP A, pipe A,
+// scaler 1A, display clocks.
+struct EwRange { uint32_t from, to; };
+static constexpr EwRange kEwRanges[] = {
+	{0x60000, 0x60100}, {0x60400, 0x60420}, {0x60500, 0x60560}, {0x70000, 0x70100}, {0x68100, 0x68200}, {0x46000, 0x46200},
+};
+static constexpr uint32_t ewBroadCount() { uint32_t n = 0; for (auto &r : kEwRanges) n += (r.to - r.from) / 4; return n; }
+static uint32_t gEwBroad[ewBroadCount()];
+static uint32_t gEwMsa;   // TRANS_MSA_MISC_A 0x60410 (bpc / colour format the sink is told)
+static uint8_t gEwCaps[16], gEwCfg[16], gEwRate;   // DPCD 0x000-0x00F, 0x100-0x10F, 0x115
+static bool gEwValid = false;
+static char gEwLog[2400]; static size_t gEwLogN = 0;
+static void ewLog(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void ewLog(const char *fmt, ...)
+{
+	char b[260]; va_list ap; va_start(ap, fmt); vsnprintf(b, sizeof(b), fmt, ap); va_end(ap);
+	IOLog("XeNG EDPWAKE %s\n", b);
+	if (gEwLogN < sizeof(gEwLog) - 2) gEwLogN += snprintf(gEwLog + gEwLogN, sizeof(gEwLog) - gEwLogN, "%s%s", gEwLogN ? "; " : "", b);
+}
+static void ewPublish(const char *key)
+{
+	if (gEdpDiagFb) gEdpDiagFb->setProperty(key, gEwLog);
+}
+static inline uint32_t ewRd(uint32_t r) { return NGreen::callback->readReg32(r); }
+static inline void ewWr(uint32_t r, uint32_t v) { NGreen::callback->writeReg32(r, v); }
+static bool ewWait(uint32_t r, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t t = 0; t <= us; t += 10) { if ((ewRd(r) & mask) == want) return true; IODelay(10); }
+	return false;
+}
+// Raw AUX on DDI A (DP_AUX_CH_CTL_A 0x64010, data 0x64014-0x64024; Linux intel_dp_aux_xfer / skl_get_aux_send_ctl).
+// Native AUX only, max 16 data bytes. Returns the number of reply data bytes, or -1.
+static int ewAux(bool write, uint32_t addr, uint8_t *buf, uint32_t len)
+{
+	if (len == 0 || len > 16) return -1;
+	for (int attempt = 0; attempt < 7; attempt++) {
+		if (!ewWait(0x64010, 1u << 31, 0, 10000)) return -1;
+		uint8_t msg[20] = {}; uint32_t n = 4;
+		msg[0] = (uint8_t)(((write ? 0x8 : 0x9) << 4) | ((addr >> 16) & 0xF));
+		msg[1] = (uint8_t)(addr >> 8); msg[2] = (uint8_t)addr; msg[3] = (uint8_t)(len - 1);
+		if (write) { for (uint32_t i = 0; i < len; i++) msg[4 + i] = buf[i]; n += len; }
+		for (uint32_t i = 0; i < n; i += 4)
+			ewWr(0x64014 + i, (uint32_t)msg[i] << 24 | (uint32_t)msg[i + 1] << 16 | (uint32_t)msg[i + 2] << 8 | msg[i + 3]);
+		const uint32_t ctl = (1u << 31) | (1u << 30) | (1u << 28) | (3u << 26) | (1u << 25) | (n << 20) | (23u << 5) | 31u;
+		ewWr(0x64010, ctl);
+		if (!ewWait(0x64010, 1u << 31, 0, 10000)) return -1;
+		const uint32_t st = ewRd(0x64010);
+		ewWr(0x64010, st | (1u << 30) | (1u << 28) | (1u << 25));   // clear done / timeout / receive error
+		if (st & ((1u << 28) | (1u << 25))) { IODelay(400); continue; }
+		const uint32_t got = (st >> 20) & 0x1F;
+		uint8_t rep[20] = {};
+		for (uint32_t i = 0; i < got && i < 20; i += 4) {
+			const uint32_t d = ewRd(0x64014 + i);
+			rep[i] = d >> 24; rep[i + 1] = d >> 16; rep[i + 2] = d >> 8; rep[i + 3] = d;
+		}
+		if (got < 1) { IODelay(400); continue; }
+		const uint8_t r = (rep[0] >> 4) & 3;
+		if (r == 2) { IODelay(500); continue; }          // DEFER
+		if (r != 0) return -1;                           // NACK
+		if (write) return (int)len;
+		const uint32_t dlen = got - 1 < len ? got - 1 : len;
+		for (uint32_t i = 0; i < dlen; i++) buf[i] = rep[1 + i];
+		return (int)dlen;
+	}
+	return -1;
+}
+static bool ewDpcdW(uint32_t addr, uint8_t v) { return ewAux(true, addr, &v, 1) == 1; }
+
+static void xeEdpWakeSave()
+{
+	if (!NGreen::callback || !(ewRd(0x70008) & 0x80000000u)) return;   // only a running eDP path
+	for (uint32_t i = 0; i < kEwCount; i++) gEwSaved[i] = ewRd(kEdpWakeRegs[i]);
+	{ uint32_t n = 0; for (auto &r : kEwRanges) for (uint32_t o = r.from; o < r.to; o += 4) gEwBroad[n++] = ewRd(o); }
+	gEwMsa = ewRd(0x60410);
+	const int a = ewAux(false, 0x000, gEwCaps, 16), b = ewAux(false, 0x100, gEwCfg, 16);
+	uint8_t st[8] = {}; const int c = ewAux(false, 0x200, st, 8);
+	gEwRate = 0; ewAux(false, 0x115, &gEwRate, 1);
+	gEwValid = a == 16 && b == 16;
+	gEwLogN = 0;
+	ewLog("save aux %d/%d/%d valid %d: caps rev %02x maxrate %02x lanes %02x tps3 %u aux_rd %02x | cfg bw %02x lanes %02x tp %02x "
+	      "lvl %02x %02x %02x %02x ds %02x code %02x rate_sel %02x | st %02x %02x %02x",
+	      a, b, c, gEwValid, gEwCaps[0], gEwCaps[1], gEwCaps[2], (gEwCaps[2] >> 6) & 1, gEwCaps[14], gEwCfg[0], gEwCfg[1],
+	      gEwCfg[2], gEwCfg[3], gEwCfg[4], gEwCfg[5], gEwCfg[6], gEwCfg[7], gEwCfg[8], gEwRate, st[2], st[3], st[4]);
+	ewLog("save dpll %x cfgcr %x/%x dpclka %x clksel %x func %x tp %x buf %x conf %x misc %x ps %x pcs %x cl10 %x dw5 %x "
+	      "dw2 %x dw4 %x dw7 %x", gEwSaved[kEwDpll], gEwSaved[kEwCfg0], gEwSaved[kEwCfg1], gEwSaved[kEwDpclka],
+	      gEwSaved[kEwClkSel], gEwSaved[kEwDdiFunc], gEwSaved[kEwTp], gEwSaved[kEwBuf], gEwSaved[kEwConf],
+	      gEwSaved[kEwMisc], gEwSaved[kEwPsCtl], gEwSaved[kEwPcs0], gEwSaved[kEwCl10], gEwSaved[kEwDw5],
+	      gEwSaved[kEwDw2], gEwSaved[kEwDw4], gEwSaved[kEwDw7]);
+	ewPublish("ngreen-edpwake-save");
+}
