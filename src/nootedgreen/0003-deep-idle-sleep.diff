+	ewWr(0x45454, ewRd(0x45454) & ~0xAAAAAAAAu); ewWr(0x45450, ewRd(0x45450) & ~0xAAAAAAAAu);   // DDI IO wells
+	ewWr(0x45404, ewRd(0x45404) & 0x3u & ~0u); ewWr(0x45400, ewRd(0x45400) & 0x3u);              // all but PW1
