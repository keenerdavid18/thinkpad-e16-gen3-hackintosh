+static IORegistryEntry *gEdpDiagFb = nullptr;   // FB0, for the ngreen-edpdiag-<tag> properties (readable without root)
+static void xeEdpDiag(const char *tag)
+{
+	if (!NGreen::callback) return;
+	char line[400]; size_t n = 0;
+	static char all[1100]; size_t an = 0;
+	const size_t cnt = sizeof(kEdpDiagRegs) / sizeof(kEdpDiagRegs[0]);
+	for (size_t i = 0; i < cnt; i++) {
+		const uint32_t v = NGreen::callback->readReg32(kEdpDiagRegs[i]);
+		n += snprintf(line + n, sizeof(line) - n, " %x=%x", kEdpDiagRegs[i], v);
+		if (an < sizeof(all)) an += snprintf(all + an, sizeof(all) - an, "%s%x=%x", i ? " " : "", kEdpDiagRegs[i], v);
+		if ((i % 8) == 7 || i == cnt - 1) { IOLog("XeNG EDPDIAG %s:%s\n", tag, line); n = 0; }
+	}
+	if (gEdpDiagFb) {
+		char key[48]; snprintf(key, sizeof(key), "ngreen-edpdiag-%s", tag);
+		gEdpDiagFb->setProperty(key, all);
+	}
+}
+static thread_call_t gEdpDiagTc = nullptr;
+static volatile uint32_t gEdpDiagStep = 0;
+static void xeEdpDiagWorker(thread_call_param_t, thread_call_param_t)
+{
+	static const uint32_t delays[] = {1000, 2000, 7000};   // +1 s, +3 s, +10 s after the wake
+	uint32_t s = gEdpDiagStep;
+	char tag[24]; snprintf(tag, sizeof(tag), "wake+%us", s == 1 ? 1 : s == 2 ? 3 : 10);
+	xeEdpDiag(tag);
+	if (++gEdpDiagStep <= 3 && gEdpDiagTc) {
+		uint64_t dl; clock_interval_to_deadline(delays[gEdpDiagStep - 1], kMillisecondScale, &dl);
+		thread_call_enter_delayed(gEdpDiagTc, dl);
+	}
+}
+static bool xeEdpDiagOn()
+{
+	static int on = -1;
+	if (on < 0) on = checkKernelArgument("-ngreenedpdiag") ? 1 : 0;
+	return on == 1;
+}
+static void xeEdpDiagAfterWake()
+{
+	if (!gEdpDiagTc) gEdpDiagTc = thread_call_allocate(xeEdpDiagWorker, nullptr);
+	if (!gEdpDiagTc) return;
+	gEdpDiagStep = 1;
+	uint64_t dl; clock_interval_to_deadline(1000, kMillisecondScale, &dl);
+	thread_call_enter_delayed(gEdpDiagTc, dl);
+}
+// XE-EDPWAKE (-ngreenedpwake, 2026-11-17): rebuild the eDP output after a Deep Idle sleep in which Apple's enableDC9
+// powered the display core off. Apple's prepareToExitSleep -> restorePowerWellsState -> enableDisplayEngine brings back
+// the power wells, CDCLK and DBUF, but the TGL FB never re-runs the eDP modeset (it cannot train eDP on display 13; at
+// boot it inherits the UEFI-trained link, -ngreenkeepefi), so DPLL1, DDI A, the link and transcoder A stay off and the
+// panel shows nothing. At FB0's sleep (link still up) this saves the eDP path registers and the panel's DPCD (raw AUX
+// A); at the wake, after Apple's restore and only when TRANSCONF_A is off, it replays the gen12 enable sequence (Linux
+// tgl_ddi_pre_enable_dp / intel_dp_link_train order) with UEFI's link parameters and lane levels. Result: property
+// ngreen-edpwake on FB0 (and IOLog "XeNG EDPWAKE").
+static bool xeEdpWakeOn()
+{
+	static int on = -1;
+	if (on < 0) on = checkKernelArgument("-ngreenedpwake") ? 1 : 0;
+	return on == 1;
+}
+static const uint32_t kEdpWakeRegs[] = {
+	0x46014, 0x16428C, 0x164290, 0x164280, 0x46140,            // DPLL1_ENABLE, DPLL1_CFGCR0/1, DPCLKA_CFGCR0, TRANS_CLK_SEL_A
+	0x60000, 0x60004, 0x60008, 0x6000C, 0x60010, 0x60014,      // TRANS_HTOTAL/HBLANK/HSYNC/VTOTAL/VBLANK/VSYNC_A
+	0x6001C, 0x60028, 0x60030, 0x60034, 0x60040, 0x60044,      // PIPESRC_A, VSYNCSHIFT, DATA_M1/N1, LINK_M1/N1
+	0x60400, 0x60404, 0x60540, 0x64000, 0x70008, 0x70030,      // TRANS_DDI_FUNC_CTL(2)_A, DP_TP_CTL_A, DDI_BUF_CTL_A, TRANSCONF_A, PIPE_MISC_A
+	0x68180, 0x68170, 0x68174,                                 // PS_CTRL_1A, PS_WIN_POS_1A, PS_WIN_SZ_1A
+	0x162604, 0x162804, 0x162028, 0x162894,                    // combo PHY A: PCS_DW1 grp/ln0, CL_DW10, TX_DW5 ln0
+	0x162888, 0x162988, 0x162A88, 0x162B88,                    // TX_DW2 ln0-3
+	0x162890, 0x162990, 0x162A90, 0x162B90,                    // TX_DW4 ln0-3
+	0x16289C, 0x16299C, 0x162A9C, 0x162B9C,                    // TX_DW7 ln0-3
+};
+enum { kEwDpll = 0, kEwCfg0, kEwCfg1, kEwDpclka, kEwClkSel, kEwHtot, kEwHblank, kEwHsync, kEwVtot, kEwVblank, kEwVsync,
+	kEwSrc, kEwVshift, kEwDm1, kEwDn1, kEwLm1, kEwLn1, kEwDdiFunc, kEwDdiFunc2, kEwTp, kEwBuf, kEwConf, kEwMisc,
+	kEwPsCtl, kEwPsPos, kEwPsSz, kEwPcsGrp, kEwPcs0, kEwCl10, kEwDw5, kEwDw2, kEwDw4 = kEwDw2 + 4, kEwDw7 = kEwDw4 + 4,
