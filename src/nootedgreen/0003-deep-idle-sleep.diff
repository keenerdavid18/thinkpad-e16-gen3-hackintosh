+// XE-EDPDIAG (-ngreenedpdiag, sleep investigation 2026-11-16): log the eDP display hardware state when XE-FBDPMS
+// fakes FB0's sleep and wake, and 1 s / 3 s / 10 s after the wake, to see what macOS Deep Idle (S0ix) loses.
+// Read-only (MMIO reads only).
+static const uint32_t kEdpDiagRegs[] = {
+	0x45400, 0x45404, 0x45444, 0x45454, 0x45504, 0x45520,   // PWR_WELL_CTL1/2, _AUX2, _DDI2, DC_STATE_EN, DC_STATE_DEBUG
+	0x101084, 0x101088,                                     // DMC DC3->DC5 / DC5->DC6 counters
+	0xC7200, 0xC7204, 0xC7208, 0xC720C, 0xC7210,            // PP_STATUS, PP_CONTROL, PP_ON/OFF_DELAYS, PP_DIVISOR
+	0xC8250, 0xC8254, 0xC8258,                              // BLC_PWM_CTL1, FREQ1, DUTY1
+	0x46000, 0x46010, 0x46014, 0x164280, 0x164284, 0x164288,// CDCLK_CTL, DPLL0/1_ENABLE, DPCLKA_CFGCR0, DPLL0_CFGCR0/1
