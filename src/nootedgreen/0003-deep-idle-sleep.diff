+void Gen11::xeFb0Pm(void *that, uint32_t cur, uint32_t state)
+{
+	static int on = -1;
+	if (on < 0) on = checkKernelArgument("-ngreenfb0pm") ? 1 : 0;
+	if (!on || cur == state) return;
+	auto *fb = static_cast<AppleIntel::AppleIntelFramebuffer *>(that);
+	if (state == 0) {
+		IOLog("XeNG FB0PM: FB0 %u -> 0: prepareToEnterSleep\n", cur);
+		prepareToEnterSleep(fb);
+	} else if (cur == 0) {
+		IOLog("XeNG FB0PM: FB0 0 -> %u: prepareToExitSleep\n", state);
+		prepareToExitSleep(fb);
+		xeEdpWakeReplay();
+	}
