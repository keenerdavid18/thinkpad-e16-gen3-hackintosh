+	0x70008, 0x6001C, 0x70040, 0x70180, 0x70188, 0x7019C,   // TRANSCONF_A, PIPESRC_A, PIPE_FRMCOUNT_A, PLANE_CTL/STRIDE/SURF_1_A
+	0x162014, 0x162100, 0x64C00,                            // PORT_CL_DW5_A, PORT_COMP_DW0_A, PHY_MISC_A
