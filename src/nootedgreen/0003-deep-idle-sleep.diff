+// XE-FB0PM (-ngreenfb0pm, 2026-11-16): XE-FBDPMS skips all four Apple lifecycle functions for FB0. Two of them
+// (prepareToExitWake / prepareToEnterWake) tear down and rebuild the pipe - still skipped. The other two are system-sleep
+// bookkeeping: prepareToEnterSleep = clientNotify(2,0) + handleEvent(kIOFBNotifyWillSleep) + hwSaveState, and
+// prepareToExitSleep = hwRestoreState + clientNotify(2,1) + handleEvent(kIOFBNotifyDidWake). Without FB0's DidWake the
+// accelerator never restarts its engines after a Deep Idle wake (WindowServer hangs, panel shows an unrendered
+// buffer). Run those two for FB0 when it really enters / leaves power state 0 (Sleep).
+// XE-WAKEBLANK (on with -ngreenfb0pm, -ngreennowakeblank disables): backlight stays off after a system-sleep wake
+// until the primary plane (PLANE_SURF_1_A 0x7019C) has flipped twice, max 3 s; while holding, BLC_CTL bit 31 is kept
+// off in case Apple's panel code turns it on early.
+static thread_call_t gWakeBlankTc = nullptr;
+static volatile uint32_t gWakeBlankTicks = 0, gWakeBlankFlips = 0, gWakeBlankSurf = 0;
+static bool xeWakeBlankOn()
+{
+	static int on = -1;
+	if (on < 0) on = (checkKernelArgument("-ngreenfb0pm") && !checkKernelArgument("-ngreennowakeblank")) ? 1 : 0;
+	return on == 1;
+}
+static void xeWakeBlankTick(thread_call_param_t, thread_call_param_t)
+{
+	auto *cb = NGreen::callback;
+	if (!cb) return;
+	const uint32_t s = cb->readReg32(0x7019C) & 0xFFFFF000u;
+	if (s != gWakeBlankSurf) { gWakeBlankSurf = s; gWakeBlankFlips++; }
+	gWakeBlankTicks++;
+	if (gWakeBlankFlips >= 2 || gWakeBlankTicks >= 60) {          // 60 x 50 ms = 3 s
+		if (gXeFbBlcDuty) cb->writeReg32(0xC8258, gXeFbBlcDuty);
+		cb->writeReg32(0xC8250, gXeFbBlcCtl | 0x80000000u);
+		IOLog("XeNG WAKEBLANK: backlight on after %u ms, %u flips\n", gWakeBlankTicks * 50, gWakeBlankFlips);
+		return;
+	}
+	const uint32_t blc = cb->readReg32(0xC8250);
+	if (blc & 0x80000000u) cb->writeReg32(0xC8250, blc & ~0x80000000u);
+	uint64_t dl; clock_interval_to_deadline(50, kMillisecondScale, &dl);
+	thread_call_enter_delayed(gWakeBlankTc, dl);
+}
+static void xeWakeBlankStart()
+{
+	if (!gWakeBlankTc) gWakeBlankTc = thread_call_allocate(xeWakeBlankTick, nullptr);
+	if (!gWakeBlankTc || !NGreen::callback) {
+		if (NGreen::callback) {
+			if (gXeFbBlcDuty) NGreen::callback->writeReg32(0xC8258, gXeFbBlcDuty);
+			NGreen::callback->writeReg32(0xC8250, gXeFbBlcCtl | 0x80000000u);
+		}
+		return;
+	}
+	gWakeBlankTicks = 0; gWakeBlankFlips = 0;
+	gWakeBlankSurf = NGreen::callback->readReg32(0x7019C) & 0xFFFFF000u;
+	uint64_t dl; clock_interval_to_deadline(50, kMillisecondScale, &dl);
+	thread_call_enter_delayed(gWakeBlankTc, dl);
+}
