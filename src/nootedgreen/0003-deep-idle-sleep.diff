+// Sink link training with the saved (UEFI) levels; source levels stay as programmed in the combo PHY.
+static bool ewTrain(uint32_t lanes, uint32_t tpBase)
+{
+	const uint8_t lvl[4] = {gEwCfg[3], gEwCfg[4], gEwCfg[5], gEwCfg[6]};
+	const uint8_t laneMask = lanes == 1 ? 0x01 : lanes == 2 ? 0x11 : 0x11;   // per status byte (2 lanes per byte)
+	auto status = [&](uint8_t *s) { return ewAux(false, 0x202, s, 6) == 6; };
+	// clock recovery: TPS1, scrambling disabled
+	ewWr(0x60540, tpBase | (0u << 8));
+	uint8_t tp1[5] = {0x21, lvl[0], lvl[1], lvl[2], lvl[3]};
+	if (ewAux(true, 0x102, tp1, 1 + lanes) < 0) { ewLog("TPS1 write failed"); return false; }
+	uint8_t s[6] = {}; bool cr = false;
+	for (int i = 0; i < 6 && !cr; i++) {
+		IODelay(500);
+		if (!status(s)) continue;
+		cr = (s[0] & laneMask) == laneMask && (lanes < 4 || (s[1] & 0x11) == 0x11);
+	}
+	ewLog("CR %s: st %02x %02x align %02x adj %02x %02x", cr ? "ok" : "FAIL", s[0], s[1], s[2], s[4], s[5]);
+	if (!cr) return false;
+	// channel equalisation: TPS3 when the sink supports it (needed at HBR2+), else TPS2
+	const bool tps3 = (gEwCaps[2] >> 6) & 1;
+	ewWr(0x60540, tpBase | ((tps3 ? 4u : 1u) << 8));
+	uint8_t tp2[5] = {(uint8_t)(0x20 | (tps3 ? 3 : 2)), lvl[0], lvl[1], lvl[2], lvl[3]};
+	if (ewAux(true, 0x102, tp2, 1 + lanes) < 0) { ewLog("TPS%u write failed", tps3 ? 3 : 2); return false; }
+	const uint32_t eqUs = (gEwCaps[14] & 0x7F) ? (gEwCaps[14] & 0x7F) * 4000u : 400u;
+	const uint8_t eqMask = lanes == 1 ? 0x07 : 0x77;
+	bool eq = false;
+	for (int i = 0; i < 6 && !eq; i++) {
+		IODelay(eqUs);
+		if (!status(s)) continue;
+		eq = (s[0] & eqMask) == eqMask && (lanes < 4 || (s[1] & 0x77) == 0x77) && (s[2] & 1);
+	}
+	ewLog("EQ(TPS%u) %s: st %02x %02x align %02x adj %02x %02x", tps3 ? 3 : 2, eq ? "ok" : "FAIL", s[0], s[1], s[2], s[4], s[5]);
+	return eq;
+}
